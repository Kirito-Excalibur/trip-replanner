# Copy to .env and fill in. Read by `langgraph dev` (server) and the `trip` CLI (client).
# `langgraph deploy` uploads the server entries as deployment secrets.

# --- Server ---
# Claude ranks repair options. Leave the key unset to use the offline heuristic.
ANTHROPIC_API_KEY=sk-ant-...
# Only for API keys not scoped to a workspace (Console > Settings > Workspaces).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# claude (default) or heuristic (offline, free, deterministic)
TRIP_RANKER=claude
# Travelers allowed in, as name:sha256(token), comma-separated. Create entries with: uv run trip token <name>
TRIP_USER_TOKENS=
# Shared secret for signing POST /webhooks/events. Empty disables the webhook.
TRIP_WEBHOOK_SECRET=

# --- Client ---
TRIP_SERVER_URL=http://127.0.0.1:2024
TRIP_TOKEN=
